# 운영 Caddyfile — web 이미지(Phase 3)에 /etc/caddy/Caddyfile 로 들어간다.
#
# - 사이트 주소는 환경변수 SITE_DOMAIN (예: <이름>.duckdns.org). 저장소에 실제 도메인을 쓰지 않는다.
# - Let's Encrypt 연락 이메일은 넣지 않는다. 이메일 없이도 발급·갱신되며,
#   Let's Encrypt는 2025년부터 만료 안내 메일을 보내지 않으므로 얻는 것이 없다 (저장소에 이메일 금지 규칙도 지킴).
# - 프론트 빌드 결과(dist)는 이미지의 /srv 에 들어간다.

{
	# 관리 API는 쓰지 않는다 (설정 변경은 재배포로만). 공격 면을 줄인다.
	admin off

	# 기본은 Let's Encrypt 운영 CA. 시험 중에는 compose가 staging 주소를 넘긴다.
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}

	servers {
		# HTTP/3(UDP 443)는 끈다. 방화벽(OCI 보안 목록·iptables)을 TCP 80/443만으로 단순하게 유지.
		protocols h1 h2

		# 요청 읽기 시간 상한. 파일 업로드가 없고 본문은 작으므로 짧게 잡는다.
		#   read_header: 요청 헤더를 다 받기까지 (Caddy 기본 1분보다 짧게).
		#   read_body  : 헤더를 포함한 요청 전체를 다 받기까지. 응답을 만드는 시간(API 처리)에는 걸리지 않는다.
		# 연결 유지 중 대기(idle)는 Caddy 기본값을 쓴다.
		timeouts {
			read_header 10s
			read_body 30s
		}
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# 업로드 본문 상한. "본문 붙여넣기"(장문 텍스트)를 감안해 넉넉히 잡되 무제한은 막는다.
	request_body {
		max_size 5MB
	}

	header {
		# HTTPS 강제 1년. preload·includeSubDomains는 넣지 않는다 (duckdns 하위 도메인이라 preload 대상이 아님).
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# index.html의 <meta name="referrer" content="no-referrer"> 와 맞춘다 (스크랩한 외부 링크로 주소 노출 방지).
		Referrer-Policy "no-referrer"
		# 다른 사이트의 iframe 안에 넣지 못하게 한다 (CSP frame-ancestors를 모르는 오래된 브라우저용으로 함께 둔다).
		X-Frame-Options "DENY"
		# CSP 근거
		#   script-src 'self'      : Vite 빌드는 외부 파일(/assets/*.js)만 쓰고 인라인 스크립트가 없다.
		#   style-src 'unsafe-inline': React의 style 속성·라이브러리의 인라인 스타일이 깨지지 않게 허용 (스크립트보다 위험이 낮음).
		#   img-src data:          : 2차 인증 QR을 data: URL 이미지로 보여 준다.
		#   connect-src 'self'     : API는 같은 출처의 /api 만 호출한다 (Claude API는 서버에서만 호출).
		#   worker-src/manifest-src: PWA 서비스워커·manifest (Phase 6).
		#   마크다운 메모의 외부 이미지는 링크로만 보여 주므로 외부 img 허용이 필요 없다.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# 클립보드 읽기("링크 붙여넣기")는 막지 않는다.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# COOP: 다른 사이트가 이 앱을 window.open 등으로 열어도 두 창이 서로의 window 참조를 갖지 못하게 분리한다.
		#   이 앱은 팝업·OAuth 창을 쓰지 않고, 외부 링크는 이미 noopener 로 연다 → 동작 변화 없음.
		Cross-Origin-Opener-Policy "same-origin"
		# CORP: 이 사이트의 응답(API JSON, 자산)을 다른 출처의 페이지가 <img>·<script> 등(no-cors)으로 끌어다 쓰지 못하게 한다.
		#   영향 확인: 같은 출처 요청에는 적용되지 않는다. PWA manifest(/manifest.webmanifest)·아이콘(/pwa-*.png,
		#   /apple-touch-icon-*.png, /favicon.svg)·서비스워커(/sw.js, /workbox-*.js)·/assets/* 는 모두 같은 출처 문서가
		#   같은 출처 경로로 불러오고, 홈 화면 아이콘은 브라우저 자체가 가져간다. 다른 출처에서 불러오는 자원도 없다(CSP 'self').
		Cross-Origin-Resource-Policy "same-origin"
		# 서버 종류(Caddy/uvicorn)를 알리지 않는다.
		-Server
	}

	# API: 경로를 그대로(/api/...) FastAPI로 넘긴다. X-Forwarded-For/Proto 는 Caddy가 자동으로 붙인다.
	handle /api/* {
		# 인증 경로(/api/auth/...)의 본문은 짧은 JSON뿐이므로 상한을 따로 낮춘다.
		# 위의 사이트 전체 상한(5MB)과 겹쳐 적용되며, 더 작은 쪽이 효력을 가진다.
		# 앱도 자체 상한을 두므로 여기는 그보다 느슨한 바깥 경계다.
		request_body /api/auth/* {
			max_size 64KB
		}
		reverse_proxy api:8000
	}

	# 해시가 붙은 빌드 자산: 내용이 바뀌면 파일 이름이 바뀌므로 1년 캐시.
	# 없는 파일은 index.html로 대신하지 않고 404 (옛 자산 요청에 HTML을 장기 캐시하는 사고 방지).
	handle /assets/* {
		root * /srv
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 해시 없는 정적 파일(PWA): 서비스워커(sw.js, workbox-*.js), registerSW.js, manifest, 아이콘 등.
	# - 없는 파일은 index.html로 대신하지 않고 404. 서비스워커가 옛 workbox-*.js 를 importScripts 하거나
	#   precache 하다가 HTML을 JS·이미지로 받아 깨지는 것을 막는다. 앱 라우트(/scraps/:id 등)는 확장자가 없으므로 영향 없음.
	# - /api/*, /assets/* 는 위 블록이 맡으므로 명시적으로 뺀다 (handle 정렬 순서에 기대지 않음).
	# - 이름이 고정이라 내용이 바뀌어도 주소가 같다 → no-cache(매번 재검증).
	# - .webmanifest 의 MIME 은 베이스 이미지의 MIME 표에 기대지 않고 명시한다.
	@static {
		path *.js *.mjs *.map *.webmanifest *.json *.png *.jpg *.jpeg *.webp *.gif *.ico *.svg *.txt *.xml *.css *.woff2
		not path /api/* /assets/*
	}
	handle @static {
		root * /srv
		header Cache-Control "no-cache"
		@manifest path *.webmanifest
		header @manifest Content-Type "application/manifest+json"
		file_server
	}

	# 나머지: 정적 파일 + SPA 폴백. index.html이 항상 최신이도록 no-cache(매번 재검증).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

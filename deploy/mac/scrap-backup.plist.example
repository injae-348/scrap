<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac 백업 가져오기 launchd 작업 예시 (deploy/README.md 14-6).
  설치: USERNAME 을 실제 홈 폴더 이름으로 바꿔 ~/Library/LaunchAgents/local.scrap-backup.pull.plist 로 저장한다
        (README 의 sed 명령이 바꿔 준다. plist 에는 ~ 나 $HOME 을 쓸 수 없어 절대경로가 필요하다).
  ⚠️ 공개 저장소: 이 예시에는 자리표시자만 둔다. 실제 사용자 이름을 넣은 파일은 커밋하지 않는다.

  실행 시각: 매일 10:00 (Mac 의 현지 시각). 서버 일일 백업(한국 시각 03:30) 뒤다.
  StartCalendarInterval 은 cron 과 달리, 그 시각에 Mac 이 잠자기 중이면 깨어난 뒤에 한 번 실행한다
  (여러 날을 잠자도 한 번으로 합쳐진다). 전원이 꺼져 있던 동안의 실행은 건너뛴다 → 다음 날 실행이 밀린 백업까지 받는다.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.scrap-backup.pull</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/USERNAME/.local/bin/scrap-pull-backups.sh</string>
	</array>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>10</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<!-- 스크립트는 자기 기록을 ~/Library/Logs/scrap-backup.log 에 남긴다. 아래는 스크립트가 시작조차 못 했을 때의 출력용. -->
	<key>StandardOutPath</key>
	<string>/Users/USERNAME/Library/Logs/scrap-backup.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USERNAME/Library/Logs/scrap-backup.launchd.log</string>

	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
</dict>
</plist>

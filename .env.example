# ⚠️ 공개 저장소: 이 파일에는 가짜 값만 둔다.
# 서버에서는 /opt/scrap-app/.env 로 복사해 서버에서 직접 채운다 (소유 deploy, 권한 600).
# 실제 .env 는 커밋하지 않는다 (.gitignore 에 등록됨). GitHub Secrets 에도 넣지 않는다.
#
# 비밀값을 `echo ... >> .env` 처럼 명령줄로 쓰지 말고 편집기(nano)로 입력한다 (셸 기록에 남지 않게).

# ─────────────────────────────────────────────
# 배포 / 웹 (Phase 2~)
# ─────────────────────────────────────────────

# 사이트 주소. Caddy가 이 이름으로 Let's Encrypt 인증서를 받는다.
# deploy.sh 도 이 값만 따로 읽어(.env 전체를 실행하지 않음) 배포 후 https://<이 주소>/api/health 를 확인한다.
# 형식: 소문자 도메인만 (https://, 경로, 포트 없이). 따옴표는 써도 되고 안 써도 된다.
SITE_DOMAIN=example.duckdns.org

# 이미지 태그 자리표시자. ⚠️ 바꾸지 않는다 (0 그대로 둔다).
# - 실제 배포 태그(커밋 SHA)는 deploy.sh 가 명령마다 환경변수로 넘기고,
#   운영 중·직전 SHA는 /opt/scrap-app/state/current, previous 에 기록된다.
# - 이 값이 있어야 사람이 `docker compose ps`/`logs` 를 태그 없이 실행할 수 있고,
#   실수로 태그 없이 pull/up 하면 없는 태그라 실패한다 (의도된 방어).
# - 수동 롤백·복구는 sudo /opt/scrap-app/deploy/rollback.sh 를 쓴다 (deploy/README.md 12-6).
IMAGE_TAG=0000000000000000000000000000000000000000

# (선택) 인증서 발급 시험용 CA. 비우거나 주석이면 Let's Encrypt 운영 CA를 쓴다.
# 발급이 계속 실패할 때만 staging으로 시험하고, 끝나면 다시 주석 처리한다 (deploy/README.md 10단계).
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ─────────────────────────────────────────────
# API 앱 (Phase 3~ — 이름은 backend 구현 시 확정, 바뀌면 이 파일도 함께 고친다)
# ─────────────────────────────────────────────

# 시간대
TZ=Asia/Seoul

# SQLite 파일 경로(DB_PATH)는 여기서 정하지 않는다.
# docker-compose.yml 의 api environment 가 /data/scrap.db 로 고정하며 .env 보다 우선한다
# (/data 는 서버 /opt/scrap-app/data 를 붙인 폴더라 그 밖에 두면 재배포 때 사라진다). 이 파일에 적어도 무시된다.

# 세션·CSRF 등에 쓰는 서버 비밀값. 서버에서 `openssl rand -hex 32` 로 만든 값을 넣는다.
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# Anthropic Claude API 키 (Phase 7). 서버에서만 사용하고 프론트로 절대 보내지 않는다.
ANTHROPIC_API_KEY=sk-ant-xxxx

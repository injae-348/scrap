# ⚠️ 공개 저장소: 이 파일에는 가짜 값만 둔다.
# 서버에서는 /opt/scrap-app/.env 로 복사해 서버에서 직접 채운다 (소유 deploy, 권한 600).
# 실제 .env 는 커밋하지 않는다 (.gitignore 에 등록됨). GitHub Secrets 에도 넣지 않는다.
#
# 비밀값을 `echo ... >> .env` 처럼 명령줄로 쓰지 말고 편집기(nano)로 입력한다 (셸 기록에 남지 않게).

# ─────────────────────────────────────────────
# 배포 / 웹 (Phase 2~)
# ─────────────────────────────────────────────

# 사이트 주소. Caddy가 이 이름으로 Let's Encrypt 인증서를 받는다.
# deploy.sh 도 이 값만 따로 읽어(.env 전체를 실행하지 않음) 배포 후 https://<이 주소>/api/health 를 확인한다.
# api 도 이 값으로 CSRF 허용 출처 https://<이 주소> 를 만든다 (Phase 4~).
# 형식: 소문자 도메인만 (https://, 경로, 포트 없이). 따옴표는 써도 되고 안 써도 된다.
SITE_DOMAIN=example.duckdns.org

# 이미지 태그 자리표시자. ⚠️ 바꾸지 않는다 (0 그대로 둔다).
# - 실제 배포 태그(커밋 SHA)는 deploy.sh 가 명령마다 환경변수로 넘기고,
#   운영 중·직전 SHA는 /opt/scrap-app/state/current, previous 에 기록된다.
# - 이 값이 있어야 사람이 `docker compose ps`/`logs` 를 태그 없이 실행할 수 있고,
#   실수로 태그 없이 pull/up 하면 없는 태그라 실패한다 (의도된 방어).
# - 수동 롤백·복구는 sudo /opt/scrap-app/deploy/rollback.sh 를 쓴다 (deploy/README.md 12-6).
IMAGE_TAG=0000000000000000000000000000000000000000

# (선택) 인증서 발급 시험용 CA. 비우거나 주석이면 Let's Encrypt 운영 CA를 쓴다.
# 발급이 계속 실패할 때만 staging으로 시험하고, 끝나면 다시 주석 처리한다 (deploy/README.md 10단계).
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ─────────────────────────────────────────────
# API 앱 (api 컨테이너만 받는다. web 컨테이너에는 SITE_DOMAIN·ACME_CA 만 넘어간다)
# 이름을 바꾸면 backend 설정과 이 파일을 함께 고친다.
# ─────────────────────────────────────────────

# 시간대
TZ=Asia/Seoul

# SQLite 파일 경로(DB_PATH)는 여기서 정하지 않는다.
# docker-compose.yml 의 api environment 가 /data/scrap.db 로 고정하며 .env 보다 우선한다
# (/data 는 서버 /opt/scrap-app/data 를 붙인 폴더라 그 밖에 두면 재배포 때 사라진다). 이 파일에 적어도 무시된다.

# 세션 서명 등에 쓰는 서버 비밀값. ⚠️ 필수 (Phase 4~).
# 아래 중 하나라도 해당하면 api 가 시작되지 않는다 → 배포 헬스체크 실패 → 직전 버전으로 자동 롤백:
#   - 줄이 없거나 값이 비어 있음
#   - 아래 자리표시자(change-me-...) 그대로
#   - 32자 미만
# 만드는 법: 서버에서 `openssl rand -hex 32` (64자) → 출력을 복사해 `sudo -u deploy nano /opt/scrap-app/.env` 로 붙여넣는다.
#   값을 명령줄에 직접 타이핑하지 않는다 (셸 기록에 남는다). 따옴표·공백 없이 한 줄로.
# 나중에 바꾸면 기존 로그인 세션이 모두 무효가 될 수 있다 (모든 기기 다시 로그인). .env 변경은 다음 배포 때 반영된다.
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# ─── AI 기능 (Phase 7) ───
# Anthropic Claude API 키. 서버(api 컨테이너)에서만 쓰고 프론트·GitHub·로그로 보내지 않는다.
# 아래 자리표시자 그대로이거나, 비어 있거나, sk-ant- 로 시작하지 않으면 앱은 정상 기동하고
# AI 기능(AI로 채우기·AI 검색)만 "사용할 수 없음"(503 ai_unavailable)으로 응답한다.
# 넣는 법: Anthropic Console 에서 만든 키를 `sudo -u deploy nano /opt/scrap-app/.env` 로 붙여넣는다
#   (명령줄에 직접 타이핑하지 않는다 — 셸 기록에 남는다). 따옴표·공백 없이 한 줄로. 다음 배포 때 반영된다.
# Console 에서 월 지출 한도를 걸어 두기를 권한다 (한도에 닿으면 AI 기능이 "이번 달 한도 도달"로 응답한다).
ANTHROPIC_API_KEY=sk-ant-xxxx

# (선택) 사용할 Claude 모델. 비우면 기본값 claude-opus-5-5. 형식이 틀리면 기본값을 쓴다.
# ANTHROPIC_MODEL=claude-opus-5-5

# (선택) Claude가 안전상 이유로 답을 거부하면 같은 요청을 Anthropic이 정한 다른 Claude 모델로 한 번 더 처리한다.
# 기본은 켜짐. 정확히 0 이면 끈다 (설정한 모델에서만 처리, 거부되면 AI 실패로 응답).
# ANTHROPIC_FALLBACKS=0

# (선택) AI 요청 제한 (AI로 채우기·AI 검색 합산, 넘으면 429). 비우면 기본값. 1 이상의 정수.
#   AI_PER_MINUTE: 분당 횟수 (기본 10, 서버 메모리)
#   AI_PER_DAY   : 하루 횟수 (기본 200, Asia/Seoul 날짜 기준, DB에 저장돼 재시작 후에도 유지)
# AI_PER_MINUTE=10
# AI_PER_DAY=200

# 최초 가입 토큰 (Phase 4~). 이 값을 아는 사람만 최초 가입(POST /api/auth/setup)을 할 수 있다.
# 도메인은 인증서 공개 기록으로 이미 알려져 있으므로, 가입 전에 남이 먼저 가입하는 것을 막는다.
# 없거나 아래 자리표시자이거나 32자 미만이면 가입 자체가 막힌다 (앱은 정상 기동).
# 만드는 법: 서버에서 `openssl rand -hex 32`. 가입을 마치면 이 줄을 지운다 (다음 배포부터 반영).
SETUP_TOKEN=change-me-generate-with-openssl-rand-hex-32

# ─────────────────────────────────────────────
# 로컬 개발 전용 (⚠️ 운영 서버 .env 에는 넣지 않는다 — 주석 그대로 둔다)
# ─────────────────────────────────────────────
# 운영에서는 CSRF 허용 출처가 https://<SITE_DOMAIN> 하나뿐이고(api 가 SITE_DOMAIN 에서 만든다), 쿠키는 항상 Secure 다.

# (로컬 개발용) 추가로 허용할 출처. 쉼표로 구분, scheme://host[:port] 형식. 운영에서는 넣지 않는다(비움).
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# (로컬 개발용) 넣지 않으면 켜짐(Secure 쿠키). 0 은 http://localhost 로 개발할 때만. 운영에서는 이 줄을 넣지 않는다.
# COOKIE_SECURE=0
